{
  "rewrites": [
    {
      "source": "/anthropic",
      "destination": "/anthropic/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/resume",
      "destination": "/api/resume"
    }
  ],
  "buildCommand": "npm run build:discovery && npm run check:discovery && node scripts/check-resume.mjs && node scripts/build-public.mjs && node scripts/check-camera-roll.mjs",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.davidgabeau.com"
        }
      ],
      "destination": "https://davidgabeau.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/writing/index.html",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/writing/:slug/index.html",
      "destination": "/writing/:slug",
      "permanent": true
    },
    {
      "source": "/frenz",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/writing/:slug.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/David_Gabeau_Resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"David_Gabeau_Resume.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://davidgabeau.com/resume>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"David_Gabeau_Resume.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://davidgabeau.com/resume>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resumes/David_Gabeau_Resume_Combined.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"David_Gabeau_Resume_Combined.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://davidgabeau.com/resume>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resumes/David_Gabeau_Resume_Product.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"David_Gabeau_Resume_Product.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://davidgabeau.com/resume>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/resumes/David_Gabeau_Resume_Investor.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"David_Gabeau_Resume_Investor.pdf\""
        },
        {
          "key": "Link",
          "value": "<https://davidgabeau.com/resume>; rel=\"canonical\""
        }
      ]
    }
  ],
  "outputDirectory": "public-site",
  "functions": {
    "api/camera-photo.js": {
      "includeFiles": "private/camera-roll/**"
    }
  }
}
